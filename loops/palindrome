
#include <stdio.h>

int main()
{
    int n,original,digit,rev=0;
    printf("enter number");
    scanf("%d",&n);
    original=n;
    while(n!=0)
    {
        digit=n%10;
        rev=rev*10+digit;
        n=n/10;
    }
    if(original==rev)
    {
    printf("%d is palindrome");
    }else
    printf("%d is not palindrome");

    return 0;
}

