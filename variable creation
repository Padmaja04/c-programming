TAKE TWO INTEGERS AND PRINT THEIR SUM

#include <stdio.h>

int main() {
    int a,b,sum;
    printf("enter two numbers:");
    scanf("%d%d",&a,&b);
    sum=a+b;
    printf("sum is %d",sum);
    

    return 0;
}
